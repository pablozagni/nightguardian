{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pablozagni/nightguardian/docs/protocol/event.v1.schema.json",
  "title": "NightGuardian ingest batch v1",
  "type": "object",
  "required": ["events"],
  "properties": {
    "sent_at": { "type": "string", "format": "date-time" },
    "sdk": { "$ref": "#/$defs/sdk" },
    "events": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "sdk": {
      "type": "object", "required": ["name", "version"],
      "properties": { "name": { "type": "string", "maxLength": 64 }, "version": { "type": "string", "maxLength": 32 } }
    },
    "level": { "enum": ["debug", "info", "notice", "warning", "error", "critical", "alert", "emergency"] },
    "frame": {
      "type": "object",
      "properties": {
        "file": { "type": "string" }, "line": { "type": ["integer", "null"] },
        "function": { "type": ["string", "null"] }, "class": { "type": ["string", "null"] },
        "in_app": { "type": "boolean" },
        "context": {
          "type": "object",
          "properties": {
            "pre": { "type": "array", "items": { "type": "string" } },
            "line": { "type": "string" },
            "post": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "exception": {
      "type": "object", "required": ["class"],
      "properties": {
        "class": { "type": "string", "maxLength": 255 },
        "message": { "type": "string", "maxLength": 8192 },
        "code": { "type": ["string", "integer", "null"] },
        "frames": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/frame" } }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "timestamp", "environment", "platform", "payload"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "enum": ["exception", "log", "job_failed", "schedule_failed", "slow_request", "slow_query", "deploy", "feedback", "test"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "level": { "$ref": "#/$defs/level" },
        "reference": { "type": "string", "pattern": "^NG-[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$" },
        "environment": { "type": "string", "maxLength": 64 },
        "release": { "type": "string", "maxLength": 128 },
        "server": { "type": "string", "maxLength": 255 },
        "platform": { "type": "string", "maxLength": 32 },
        "sdk": { "$ref": "#/$defs/sdk" },
        "fingerprint": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
        "tags": { "type": "object", "maxProperties": 20, "additionalProperties": { "type": "string", "maxLength": 200 } },
        "context": { "type": "object" },
        "user": { "type": "object", "properties": { "id": { "type": ["string", "integer"] }, "email": { "type": "string" }, "name": { "type": "string" } } },
        "request": { "type": "object" },
        "runtime": { "type": "object" },
        "payload": { "type": "object" }
      }
    }
  }
}
